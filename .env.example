# Discord Bot Authentication Token
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Connection URL
# For Docker Compose, the host is 'postgres'
# For local host development, change 'postgres' to 'localhost'
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/discord_ai

# Optional: Host port mapping for PostgreSQL (defaults to 5432; use 5433 if host port 5432 is occupied)
# POSTGRES_PORT=5433

# Discord Snowflake ID of the bot administrator/owner
OWNER_ID=123456789012345678

# Discord Snowflake ID of the target user whose communication style will eventually be modeled
TARGET_USER_ID=123456789012345678


# Optional: Specific Discord Server/Guild ID for development / testing
# DEV_GUILD_ID=123456789012345678

# Structured logging level (e.g., trace, debug, info, warn, error)
RUST_LOG=info

# Instagram Webhook Configuration
# VERIFY_TOKEN or INSTAGRAM_VERIFY_TOKEN for Meta webhook verification
INSTAGRAM_VERIFY_TOKEN=your_meta_webhook_verify_token_here
# Port to expose for the webhook gateway (defaults to 3000)
INSTAGRAM_WEBHOOK_PORT=3000
# Target Discord Channel ID where reels will be posted (can also be set dynamically via /instagram channel set)
INSTAGRAM_TARGET_CHANNEL_ID=123456789012345678

